{
  "name": "xuji-anomaly-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/verify_report.mjs",
    "typecheck": "tsc -b",
    "verify:data": "node scripts/verify_journey_data.mjs && npm run verify:windows && npm run verify:cases",
    "export:data": "python -X utf8 -B scripts/export_journey.py",
    "verify": "npm run verify:data && npm test && npm run test:browser",
    "verify:windows": "python -X utf8 -B scripts/verify_windows.py",
    "verify:cases": "python -X utf8 -B scripts/verify_anomaly_cases.py",
    "verify:loading": "node scripts/verify_loading.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
